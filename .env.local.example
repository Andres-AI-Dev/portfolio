# Environment Variables Template
# Copy this file to .env.local and fill in your actual values

# Contact Form Configuration
# Get your API key from https://resend.com
RESEND_API_KEY=your_resend_api_key_here

# Address that receives contact form submissions (required for the form to work)
CONTACT_EMAIL=you@example.com

# Sender address for contact emails (optional)
# Defaults to the Resend sandbox address until you verify a custom domain in Resend
CONTACT_FROM=Portfolio Contact <onboarding@resend.dev>

# GitHub API (Optional - increases rate limit for fetching repo stars)
# Generate at: https://github.com/settings/tokens
GITHUB_TOKEN=your_github_personal_access_token_here

# Canonical site URL used for absolute links, metadata, and RSS (optional)
# Falls back to http://localhost:3000 in development and the production domain otherwise
NEXT_PUBLIC_BASE_URL=https://www.andreslearns.org
